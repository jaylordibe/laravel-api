# Keep local-only and secret files out of the image (`COPY . .` copies the whole build context).
.git
.gitignore
.gitattributes
.editorconfig
tests
storage/logs
storage/framework
# Runtime configuration is injected by the platform, never baked in.
.env
.env.*
# Passport signing keys from local `passport:keys`; production injects them via env.
storage/*.key
# Local framework caches can hold resolved credentials; the entrypoint rebuilds them.
bootstrap/cache/*
storage/app
database/*.sqlite*
docker-compose.yml
# Database volumes only: docker/entrypoint.sh and docker/healthcheck.sh are COPYed.
docker/database/
# Installed from composer.lock with --no-dev inside the image.
vendor
**/auth.json
**/*.bak
**/.phpactor.json
**/Homestead.json
**/Homestead.yaml
**/.DS_Store
**/supervisord.pid
.fleet
.vscode
*.md
start.sh
stop.sh
test.sh
test-pipeline.sh
.github
.claude
.junie
.idea
.zap
.trivyignore
.phpunit.result.cache
.phpunit.cache
phpunit.xml
api.json
boost.json
public/storage
