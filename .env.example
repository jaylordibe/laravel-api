APP_NAME=API
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:4200
APP_DOMAIN="app.local"

SERVICE_NAME="laravel"

# CORS_ALLOWED_ORIGINS should be a comma-separated list of allowed origins for CORS requests.
# In this case, it allows requests from the frontend defined in APP_FRONTEND_URL.
# If you have multiple frontend URLs, you can add them here separated by commas.
CORS_ALLOWED_ORIGINS="${APP_FRONTEND_URL}"

# Local development logs to dated files so a developer can tail them.
# PRODUCTION MUST USE `stderr` — see the "Logging" notes in DEPLOYMENT.md. A
# container's log stream is the only place a platform can collect from; a file
# inside an ephemeral filesystem is written, rotated and then thrown away.
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------
# DB_SSLMODE defaults to `require` in config/database.php. It is `disable` here
# because the local database is a container on a private compose network with no
# TLS configured. Every deployed environment must leave it unset (to get
# `require`) or, for a database reached over a network you do not control, set it
# to `verify-full` together with DB_SSL_ROOT_CERT.
DB_CONNECTION=pgsql
DB_HOST="${SERVICE_NAME}-db"
DB_PORT=5432
DB_DATABASE="${SERVICE_NAME}_local"
DB_USERNAME="${SERVICE_NAME}"
DB_PASSWORD="25dR5^MLfdGKPkM7"
DB_SSLMODE=disable

# Testing Database
TEST_DB_CONNECTION=pgsql
TEST_DB_HOST="${SERVICE_NAME}-db-test"
TEST_DB_PORT=5432
TEST_DB_DATABASE="${SERVICE_NAME}_test"
TEST_DB_USERNAME="${SERVICE_NAME}"
TEST_DB_PASSWORD="aDY^2dHjZyUupf6k"

# Local pgAdmin credentials (replaces phpMyAdmin, which speaks MySQL only).
#
# NOT derived from APP_DOMAIN: that is "app.local", and pgAdmin refuses to start
# on an address whose TLD is a special-use name (.local, .localhost, .test,
# .invalid) — it exits non-zero and the container crash-loops. This value is only
# ever the local pgAdmin login.
PGADMIN_EMAIL="dev@example.com"
PGADMIN_PASSWORD="pgadmin"

# ---------------------------------------------------------------------------
# Drivers
# ---------------------------------------------------------------------------
# CACHE_STORE, not CACHE_DRIVER: config/cache.php reads CACHE_STORE, so the old
# Laravel 10 name was being silently ignored and the cache was falling through to
# the `database` store. Same for BROADCAST_CONNECTION.
#
# `file` is fine for a single local container. ANY horizontally scaled deployment
# must use `redis`, because a file cache is per-replica: cache entries, atomic
# locks and `onOneServer` scheduling all stop working across containers, and none
# of it produces an error. app:check-config fails production on this.
BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# One generic set of variables serves any Redis-compatible backend. TLS is
# opt-in; when enabled, peer verification is always on and REDIS_TLS_CA supplies
# a private CA if the endpoint uses one.
REDIS_HOST="${SERVICE_NAME}-redis"
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false
#REDIS_TLS_CA=/etc/ssl/certs/redis-ca.pem

