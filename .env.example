APP_NAME=API
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:4200
APP_DOMAIN="app.local"

SERVICE_NAME="laravel"

# CORS_ALLOWED_ORIGINS should be a comma-separated list of allowed origins for CORS requests.
# In this case, it allows requests from the frontend defined in APP_FRONTEND_URL.
# If you have multiple frontend URLs, you can add them here separated by commas.
CORS_ALLOWED_ORIGINS="${APP_FRONTEND_URL}"

# Local development logs to dated files so a developer can tail them.
# PRODUCTION MUST USE `stderr` — see the "Logging" notes in DEPLOYMENT.md. A
# container's log stream is the only place a platform can collect from; a file
# inside an ephemeral filesystem is written, rotated and then thrown away.
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===========================================================================
# EVERY CREDENTIAL IN THIS FILE IS A LOCAL-DEVELOPMENT PLACEHOLDER
# ===========================================================================
# They are written to read as placeholders — "local-dev-only-change-me" — rather
# than as plausible generated secrets, and that is deliberate. This file used to
# ship values like `25dR5^MLfdGKPkM7`, which look exactly like something already
# chosen for you: it is indistinguishable from a real secret at a glance, so a
# fork copies .env.example to .env, fills in the hostnames, and ships with a
# password that is published in a public template repository and shared by every
# other fork of it.
#
# A deployed environment must supply its own values through its platform's
# secret injection. See DEPLOYMENT.md §4b for the full list.

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------
# This template targets PostgreSQL end to end (config/database.php, the compose
# services, the test suite and CI). Where that PostgreSQL runs — a managed
# service, a container, Kubernetes, a VM — is a deployment decision the
# application knows nothing about.
#
# DB_SSLMODE defaults to `require` in config/database.php. It is `disable` here
# because the local database is a container on a private compose network with no
# TLS configured. Every deployed environment must leave it unset (to get
# `require`) or, for a database reached over a network you do not control, set it
# to `verify-full` together with DB_SSL_ROOT_CERT.
DB_CONNECTION=pgsql
DB_HOST="${SERVICE_NAME}-db"
DB_PORT=5432
DB_DATABASE="${SERVICE_NAME}_local"
DB_USERNAME="${SERVICE_NAME}"
DB_PASSWORD="local-dev-only-change-me"
DB_SSLMODE=disable
# Verified TLS to a database on an untrusted network. Unused locally.
#DB_SSLMODE=verify-full
#DB_SSL_ROOT_CERT=/etc/ssl/certs/db-ca.pem
# Mutual TLS, where the endpoint requires a client certificate.
#DB_SSL_CERT=
#DB_SSL_KEY=
# Bounds the CONNECT handshake, so an unreachable database cannot park every
# php-fpm worker until the OS gives up.
#DB_CONNECT_TIMEOUT=5
# Identifies this workload in pg_stat_activity. Worth setting per runtime.
#DB_APPLICATION_NAME="${APP_NAME}-api"
# A single DSN, for a managed service that hands out exactly one connection
# string. When set it wins over the discrete values above.
#DB_URL=

# Testing Database. TEST_DB_PASSWORD provisions the test container in
# docker-compose.yml; .env.testing must carry the SAME value as DB_PASSWORD, or
# the suite authenticates against a database it just created with another one.
TEST_DB_CONNECTION=pgsql
TEST_DB_HOST="${SERVICE_NAME}-db-test"
TEST_DB_PORT=5432
TEST_DB_DATABASE="${SERVICE_NAME}_test"
TEST_DB_USERNAME="${SERVICE_NAME}"
TEST_DB_PASSWORD="local-test-only-change-me"

# Local pgAdmin credentials (replaces phpMyAdmin, which speaks MySQL only).
#
# NOT derived from APP_DOMAIN: that is "app.local", and pgAdmin refuses to start
# on an address whose TLD is a special-use name (.local, .localhost, .test,
# .invalid) — it exits non-zero and the container crash-loops. This value is only
# ever the local pgAdmin login.
PGADMIN_EMAIL="dev@example.com"
PGADMIN_PASSWORD="local-dev-only-change-me"

# ---------------------------------------------------------------------------
# Drivers
# ---------------------------------------------------------------------------
# CACHE_STORE, not CACHE_DRIVER: config/cache.php reads CACHE_STORE, so the old
# Laravel 10 name was being silently ignored and the cache was falling through to
# the `database` store. Same for BROADCAST_CONNECTION.
#
# `file` is fine for a single local container. ANY horizontally scaled deployment
# must use `redis`, because a file cache is per-replica: cache entries, atomic
# locks and `onOneServer` scheduling all stop working across containers, and none
# of it produces an error. app:check-config fails production on this.
BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# One generic set of variables serves any Redis-compatible backend — a local
# container, an authenticated managed instance, a TLS endpoint with a private CA.
# There are deliberately no provider-named variables: the application asks for
# "a Redis-compatible backend" and which product answers is a deployment concern.
#
# The cache, the queue, Horizon, atomic locks and rate limiting all resolve
# through ONE connection definition, so transport security cannot drift between
# them (config/database.php).
REDIS_CLIENT=phpredis
REDIS_HOST="${SERVICE_NAME}-redis"
REDIS_PORT=6379
# ACL username and password. Managed endpoints usually issue both; supplying only
# the password silently leaves you on the `default` ACL user.
REDIS_USERNAME=
REDIS_PASSWORD=
# A full DSN (redis://user:pass@host:port/db, rediss:// for TLS), for a service
# that hands out one connection string. Wins over the discrete values above.
#REDIS_URL=

# TLS is opt-in. When enabled, PEER VERIFICATION IS ALWAYS ON — there is no
# variable to disable it, because TLS to an unverified peer defends against a
# passive listener only, and an untrusted network is the whole reason to enable
# it. A private or internal CA is SUPPLIED here rather than ignored.
REDIS_TLS_ENABLED=false
#REDIS_TLS_CA=/etc/ssl/certs/redis-ca.pem
# Only for an endpoint that requires mutual TLS.
#REDIS_TLS_CERT=
#REDIS_TLS_KEY=
# Bounded, so a hung Redis surfaces as a failed request rather than a parked
# php-fpm worker or queue process.
#REDIS_TIMEOUT=5
#REDIS_READ_TIMEOUT=10
# Separate logical databases, so `cache:clear` cannot wipe queued jobs, Horizon's
# metadata or a lock somebody is holding.
#REDIS_DB=0
#REDIS_CACHE_DB=1

# For mailpit smtp server
#MAIL_MAILER=smtp
#MAIL_HOST=mailpit
#MAIL_PORT=1025
#MAIL_USERNAME=null
#MAIL_PASSWORD=null
#MAIL_ENCRYPTION=null
#MAIL_FROM_ADDRESS="hello@${APP_DOMAIN}"
# For mailgun smtp server
MAIL_MAILER=mailgun
MAILGUN_DOMAIN="addValueHere"
MAILGUN_SECRET="addValueHere"
MAIL_FROM_ADDRESS="addValueHere"
# For sendgrid smtp server
#MAIL_MAILER=smtp
#MAIL_HOST=smtp.sendgrid.net
#MAIL_PORT=587
#MAIL_USERNAME=apikey
#MAIL_PASSWORD=addValueHere
#MAIL_ENCRYPTION=tls
#MAIL_FROM_ADDRESS="no-reply@${APP_DOMAIN}"
# For gmail smtp server
#MAIL_MAILER=smtp
#MAIL_HOST=smtp.googlemail.com
#MAIL_PORT=465
#MAIL_USERNAME="connect.${SERVICE_NAME}@gmail.com"
#MAIL_PASSWORD="addValueHere"
#MAIL_ENCRYPTION=ssl
#MAIL_FROM_ADDRESS="connect.${SERVICE_NAME}@gmail.com"
# Common mail settings
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# FILESYSTEM_DISK above selects the disk. Every disk stores objects PRIVATELY;
# the application hands out short-lived signed URLs instead of public links.
#
# Leave the credentials below EMPTY in a deployed environment: each SDK then
# falls back to its ambient credential chain (an attached role or managed
# identity), which is the recommended production path. Static keys are for local
# development and for S3-compatible storage with no identity story.
# Which disk App\Utils\FileUtil reads and writes. Defaults to FILESYSTEM_DISK.
#APP_STORAGE_DISK=
# Signed-URL lifetime in minutes for stored objects. Short on purpose — a signed
# URL is a bearer credential for one object.
#APP_STORAGE_TEMPORARY_URL_TTL=15
# Largest accepted image upload, in kilobytes.
#APP_MAX_IMAGE_UPLOAD_KB=5120
# Lets temporaryUrl() work on the local disk by registering signed
# GET/PUT /storage/{path} routes. Setting this false removes those routes and
# makes temporaryUrl() throw on `local`.
#FILESYSTEM_LOCAL_SERVE=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# S3-compatible (non-AWS) endpoint: set AWS_ENDPOINT and usually path-style URLs.
#AWS_ENDPOINT=

# Google Cloud Storage. With GOOGLE_CLOUD_KEY_FILE unset the client uses
# Application Default Credentials — no service-account JSON to ship.
#GOOGLE_CLOUD_PROJECT_ID=
#GOOGLE_CLOUD_STORAGE_BUCKET=
#GOOGLE_CLOUD_KEY_FILE=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Seeded administrator accounts.
#
# THE HIGHEST-RISK VALUES IN THIS FILE. `database/seeders/UserSeeder.php` creates
# real accounts with these credentials and the system-admin role, so a deployment
# that seeds with an unchanged value has a published password on its most
# privileged account. Treat them as secrets in every environment that runs the
# seeder.
SYSAD_EMAIL="sysad@${APP_DOMAIN}"
SYSAD_PASSWORD="local-dev-only-change-me"

APPAD_EMAIL="appad@${APP_DOMAIN}"
APPAD_PASSWORD="local-dev-only-change-me"

# ===========================================================================
# DEPLOYMENT-ONLY VARIABLES
# ===========================================================================
# Everything below is commented out because local development does not need any
# of it: docker-compose runs the base image directly, which serves on :80 and
# runs Horizon in the same container.
#
# These matter for the PRODUCTION image built from the Dockerfile. DEPLOYMENT.md
# is the authoritative description of the runtime contract; this block exists so
# the variable NAMES live next to every other variable.

# --- Runtime selection ---
# api (default) | worker | scheduler | migrate | artisan | all
#APP_RUNTIME_MODE=api
# HTTP port for `api`/`all`. Defaults to 80. Set it when the platform dictates
# one (some managed runtimes inject PORT themselves, which is also honoured).
#PORT=8080
# Runtime config/route caching. Leave unset (true). Set false only for a
# read-only root filesystem, which makes the container slower but still correct.
#APP_RUNTIME_CONFIG_CACHE=true
# Fail-fast configuration check on startup for api/worker. Leave unset (true).
#APP_CONFIG_CHECK=true

# --- Reverse proxies ---
# EMPTY BY DEFAULT, which means no proxy is trusted and X-Forwarded-* headers are
# ignored. Behind a load balancer this must be set, or Laravel generates http://
# URLs for an https:// site and every client IP is the balancer's.
# Use a CIDR/address list, or `*` when the balancer's address is not knowable
# (typical on managed container platforms, where nothing else can reach the
# container). Read by Laravel's own TrustProxies middleware via
# config/trustedproxy.php; the trusted HEADER set is pinned in bootstrap/app.php,
# where X-Forwarded-Host is deliberately excluded.
#TRUSTED_PROXIES=*

# --- Queue workers (worker runtime) ---
# EVERY concurrency knob is environment-driven; none is hard-coded in
# config/horizon.php. Scaling is a variable change, not a code change.
#
# Container scale and Horizon's child processes MULTIPLY:
#
#   worker container replicas x HORIZON_MAX_PROCESSES = queue consumers
#
# and every consumer holds a database connection while it works, on the same
# server-side limit the API's php-fpm workers use. Do the arithmetic in
# DEPLOYMENT.md §5 before raising this; the default is deliberately conservative.
#HORIZON_MAX_PROCESSES=5
#HORIZON_MIN_PROCESSES=1
#HORIZON_BALANCE=auto
#HORIZON_MEMORY=128
#HORIZON_TRIES=3
# Must stay BELOW the queue's retry_after (90s), or a job is handed to a second
# worker while the first is still running it. Startup refuses otherwise.
#HORIZON_TIMEOUT=60
# Comma-separated queues this container consumes.
#HORIZON_QUEUES=default
# Recycle a worker after N jobs / N seconds. Bounds a slow leak. 0 disables.
#HORIZON_MAX_JOBS=0
#HORIZON_MAX_TIME=0
# Queue-side release window. Keep it above HORIZON_TIMEOUT.
#REDIS_QUEUE_RETRY_AFTER=90
# Restricts the Horizon dashboard to these emails in non-local environments.
# EMPTY means nobody, which is the safe default — the dashboard exposes job
# payloads.
#HORIZON_DASHBOARD_EMAILS=

# --- Passport ---
# Generate ONCE per environment and inject as secrets. Never generate at
# container start: a per-replica key pair invalidates tokens minted by every
# other replica. Multi-line PEM content is supported directly; a value using
# literal \n escapes is also accepted (see config/passport.php).
#PASSPORT_PRIVATE_KEY=
#PASSPORT_PUBLIC_KEY=

# --- Logging ---
# Production must log to the container's stream, not to a file inside it.
#LOG_CHANNEL=stderr
#LOG_LEVEL=info
# Structured JSON log lines, which most log platforms parse into query fields.
#LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# --- Health probes ---
# Ceiling on the readiness endpoint's database probe, in milliseconds. Applied as
# a transaction-local statement_timeout, so a database that accepts connections
# and then blocks cannot hold php-fpm workers until the pool is exhausted.
#HEALTH_DB_TIMEOUT_MS=3000

# --- API docs (dedoc/scramble) ---
# Access to /docs/api and /docs/api.json, enforced by
# App\Http\Middleware\RestrictApiDocsAccess.
#
# `local` is always open and ignores all three. `production` is always 403 and
# ignores them too: the document is a complete map of the API, including which
# routes answer without a token, so enabling it there is a code change and a
# review rather than an env edit. These apply to staging, review apps and any
# other deployed environment, where the docs stay closed until the flag is on
# AND both halves of the credential are set — either one left blank counts as
# unconfigured and denies.
#
# The credential is SHARED, not a platform account: it is handed to client
# developers so they can read the contract, and grants nothing but the document.
# Generate the password with `openssl rand -base64 24`, inject it as a secret,
# and never commit a real value here.
#API_DOCS_ENABLED=false
#API_DOCS_USERNAME=
#API_DOCS_PASSWORD=
