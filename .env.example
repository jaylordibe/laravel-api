MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# FILESYSTEM_DISK above selects the disk. Every disk stores objects PRIVATELY;
# the application hands out short-lived signed URLs instead of public links.
#
# Leave the credentials below EMPTY in a deployed environment: each SDK then
# falls back to its ambient credential chain (an attached role or managed
# identity), which is the recommended production path. Static keys are for local
# development and for S3-compatible storage with no identity story.
# Which disk App\Utils\FileUtil reads and writes. Defaults to FILESYSTEM_DISK.
#APP_STORAGE_DISK=
# Signed-URL lifetime in minutes for stored objects. Short on purpose — a signed
# URL is a bearer credential for one object.
#APP_STORAGE_TEMPORARY_URL_TTL=15
# Largest accepted image upload, in kilobytes.
#APP_MAX_IMAGE_UPLOAD_KB=5120
# Lets temporaryUrl() work on the local disk by registering signed
# GET/PUT /storage/{path} routes. Setting this false removes those routes and
# makes temporaryUrl() throw on `local`.
#FILESYSTEM_LOCAL_SERVE=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# S3-compatible (non-AWS) endpoint: set AWS_ENDPOINT and usually path-style URLs.
#AWS_ENDPOINT=

# Google Cloud Storage. With GOOGLE_CLOUD_KEY_FILE unset the client uses
# Application Default Credentials — no service-account JSON to ship.
#GOOGLE_CLOUD_PROJECT_ID=
#GOOGLE_CLOUD_STORAGE_BUCKET=
#GOOGLE_CLOUD_KEY_FILE=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Required for creating the system admin user
SYSAD_EMAIL="sysad@${APP_DOMAIN}"
SYSAD_PASSWORD="1F8g_<Pbu16q"

# Required for creating the app admin user
APPAD_EMAIL="appad@${APP_DOMAIN}"
APPAD_PASSWORD="6F9my3L}<5kV"

# ===========================================================================
# DEPLOYMENT-ONLY VARIABLES
# ===========================================================================
# Everything below is commented out because local development does not need any
# of it: docker-compose runs the base image directly, which serves on :80 and
# runs Horizon in the same container.
#
# These matter for the PRODUCTION image built from the Dockerfile. DEPLOYMENT.md
# is the authoritative description of the runtime contract; this block exists so
# the variable NAMES live next to every other variable.

# --- Runtime selection ---
# api (default) | worker | scheduler | migrate | artisan | all
#APP_RUNTIME_MODE=api
# HTTP port for `api`/`all`. Defaults to 80. Set it when the platform dictates
# one (some managed runtimes inject PORT themselves, which is also honoured).
#PORT=8080
# Runtime config/route caching. Leave unset (true). Set false only for a
# read-only root filesystem, which makes the container slower but still correct.
#APP_RUNTIME_CONFIG_CACHE=true
# Fail-fast configuration check on startup for api/worker. Leave unset (true).
#APP_CONFIG_CHECK=true

# --- Reverse proxies ---
# EMPTY BY DEFAULT, which means no proxy is trusted and X-Forwarded-* headers are
# ignored. Behind a load balancer this must be set, or Laravel generates http://
# URLs for an https:// site and every client IP is the balancer's.
# Use a CIDR/address list, or `*` when the balancer's address is not knowable
# (typical on managed container platforms, where nothing else can reach the
# container). Read by Laravel's own TrustProxies middleware via
# config/trustedproxy.php; the trusted HEADER set is pinned in bootstrap/app.php,
# where X-Forwarded-Host is deliberately excluded.
#TRUSTED_PROXIES=*

# --- Queue workers (worker runtime) ---
# Total Horizon worker PROCESSES per container. Each one holds its own database
# connection while running a job; see the capacity arithmetic in DEPLOYMENT.md
# before raising it.
#HORIZON_MAX_PROCESSES=5
#HORIZON_MIN_PROCESSES=1
#HORIZON_BALANCE=auto
#HORIZON_MEMORY=128
#HORIZON_TRIES=3
#HORIZON_TIMEOUT=60
# Restricts the Horizon dashboard to these emails in non-local environments.
# EMPTY means nobody, which is the safe default — the dashboard exposes job
# payloads.
#HORIZON_DASHBOARD_EMAILS=

# --- Passport ---
# Generate ONCE per environment and inject as secrets. Never generate at
# container start: a per-replica key pair invalidates tokens minted by every
# other replica. Multi-line PEM content is supported directly; a value using
# literal \n escapes is also accepted (see config/passport.php).
#PASSPORT_PRIVATE_KEY=
#PASSPORT_PUBLIC_KEY=

# --- Logging ---
# Production must log to the container's stream, not to a file inside it.
#LOG_CHANNEL=stderr
#LOG_LEVEL=info
# Structured JSON log lines, which most log platforms parse into query fields.
#LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# NOTE ON API DOCS: /docs/api and /docs/api.json are already restricted to the
# local environment by Scramble's RestrictedDocsAccess middleware (see
# config/scramble.php). There is no variable to enable them elsewhere on purpose
# — exposing them is a deliberate act, done by defining a `viewApiDocs` gate.
